{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "abox-tools",
  "version": "0.2.0",
  "description": "Compress images, split PDFs, and remove image metadata with the existing abox.tools code, keeping file processing local.",
  "author": {
    "name": "A Box of Tools",
    "url": "https://abox.tools/"
  },
  "homepage": "https://abox.tools/",
  "repository": "https://github.com/A-Box-of-Tools/abox-tools-plugin",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "abox.tools",
        "shortDescription": "Process local images and PDFs",
        "developerName": "A Box of Tools",
        "category": "Productivity",
        "capabilities": ["Read", "Write"],
        "logo": "./assets/icon.png",
        "composerIcon": "./assets/icon.png"
      }
    }
  }
}
